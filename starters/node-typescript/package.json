{
  "name": "@modular-application-foundation/node-typescript-skeleton",
  "version": "0.1.0",
  "private": true,
  "description": "Runnable Node.js/TypeScript vertical slice implementing Modular Application Foundation ports and boundaries.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/app/main.js",
    "dev": "tsx src/app/main.ts",
    "migrate": "tsx src/app/migrate.ts",
    "prune:sessions": "tsx src/app/prune-sessions.ts",
    "outbox:status": "tsx src/app/outbox-status.ts",
    "test": "vitest run",
    "test:postgres": "npm run build && node scripts/test-postgres.mjs",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1"
  }
}
